# Vigil — Environment Configuration
# Copy this file to .env and fill in the values.
# Never commit your actual .env file.

# ── Kite Network ─────────────────────────────────────────────────────────────
KITE_RPC_URL=https://rpc-testnet.gokite.ai
KITE_CHAIN_ID=2368

# ── Kite Testnet Addresses ───────────────────────────────────────────────────
SETTLEMENT_TOKEN=0x0fF5393387ad2f9f691FD6Fd28e07E3969e27e63
SETTLEMENT_CONTRACT=0x8d9FaD78d5Ce247aA01C140798B9558fd64a63E3

# ── LayerZero Blocklist (core contracts flagged as CRITICAL) ─────────────────
LZ_ENDPOINT_V2=0x6F475642a6e85809B1c36Fa62763669b1b48DD5B

# ── Vigil Contracts (deployed on Kite Testnet) ───────────────────────────────
AGENT_REGISTRY_ADDRESS=0xB41227F66f7963A902af16Ec41eC803198B09068
# Optional: used to write trust scores on-chain after each action
REPORTER_PRIVATE_KEY=

# ── LLM (OpenRouter — required for Guide + Rule Composer) ────────────────────
OPENROUTER_KEY=
LLM_TIMEOUT=10000

# ── Server Configuration ─────────────────────────────────────────────────────
PORT=3001
# stdio = MCP protocol (Claude/Cursor), rest = HTTP dashboard mode
MCP_TRANSPORT=rest

# ── Supabase (required for authenticated dashboard feed) ─────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Demo Agent Identity ───────────────────────────────────────────────────────
# Run: node scripts/seed-demo-data.js after setting these
AGENT_ADDRESS=
SESSION_ID=